# Pass these variables with docker run --env-file or individual -e flags.
LLPS_PUBLISHED_PORT=25565
LLPS_TARGET_HOST=chat-target
LLPS_TARGET_PORT=25566

LLPS_MAX_CLIENTS=256
LLPS_BUFFER_SIZE=4096
LLPS_LISTEN_BACKLOG=256
LLPS_ACCEPT_BATCH_MAX=32
LLPS_SESSION_IDLE_TIMEOUT_MS=30000
LLPS_MAX_SESSIONS_PER_CLIENT_IP=0
LLPS_MAX_NEW_SESSIONS_PER_CLIENT_IP_PER_WINDOW=0
LLPS_CLIENT_IP_RATE_WINDOW_MS=1000
LLPS_CLIENT_PREFACE_TIMEOUT_MS=0
# Protocol-only hardening: set timeout to 1000-2000 and enable this together.
LLPS_PROTOCOL_HANDSHAKE_GATE_ENABLED=0
LLPS_PAYLOAD_ECC_ENABLED=1

LLPS_IP_AUDIT_ENABLED=1
LLPS_IP_AUDIT_PATH=/var/log/llps/llps-ip-audit.pxf

# Keep disabled unless the host/container is explicitly prepared for the
# platform evidence checks and memory-lock requirements. Containers commonly
# lack access to EDAC sysfs, NUMA placement syscalls, or /proc/self/pagemap;
# with readiness enabled, those unavailable observations fail closed.
LLPS_REQUIRE_READINESS=0
LLPS_PLATFORM_SAFETY_FLAGS=7
LLPS_PLATFORM_SAFETY_EVIDENCE_ID=42424242
LLPS_PLATFORM_ATTESTATION_FINGERPRINT=1519046679
LLPS_PLATFORM_OBSERVATION_DIGEST=0
LLPS_PLATFORM_EVIDENCE_MODE=synthetic

# Synthetic software evidence. This exercises the software ECC/NUMA paths
# without physical ECC DIMMs, NUMA nodes, or DMI identity exposure; it is not
# hardware proof. Keep require_readiness disabled unless you generate and pin
# the matching observation digest for the exact host/container image.
LLPS_SOFTWARE_ECC_ENABLED=1
LLPS_SOFTWARE_ECC_CONTROLLER_COUNT=1
LLPS_SOFTWARE_ECC_DIMM_COUNT=8
LLPS_SOFTWARE_ECC_SCRUB_RATE=4096
LLPS_SOFTWARE_ECC_CONTROLLER_CORRECTED_ERROR_COUNT=0
LLPS_SOFTWARE_ECC_CONTROLLER_UNCORRECTED_ERROR_COUNT=0
LLPS_SOFTWARE_ECC_DIMM_CORRECTED_ERROR_COUNT=0
LLPS_SOFTWARE_ECC_DIMM_UNCORRECTED_ERROR_COUNT=0
LLPS_SOFTWARE_NUMA_ENABLED=1
LLPS_SOFTWARE_NUMA_MEMTOTAL_KIB=1048576
LLPS_SOFTWARE_NUMA_LOCAL_DISTANCE=10
LLPS_SOFTWARE_NUMA_REMOTE_DISTANCE=20
LLPS_SOFTWARE_FAULT_INJECTION_MODE=full
LLPS_PHYS_MEM_DOMAIN0=11
LLPS_PHYS_MEM_DOMAIN1=22
LLPS_PHYS_MEM_DOMAIN2=33
LLPS_HW_TMR_DOMAIN0=0
LLPS_HW_TMR_DOMAIN1=0
LLPS_HW_TMR_DOMAIN2=0
LLPS_HW_TMR_VOTER_DOMAIN=0

LLPS_AUDIT_MAC_ENABLED=0
LLPS_AUDIT_MAC_KEY_PATH=/run/llps-secrets/llps-audit.key
LLPS_EVIDENCE_MAC_ENABLED=0
LLPS_EVIDENCE_MAC_KEY_PATH=/run/llps-secrets/llps-evidence.key
LLPS_SECRETS_DIR=./docker/empty-secrets

# Production default: lifecycle logs on, per-read byte logs off.
LLPS_LOG=1
LLPS_LOG_AUDIT=1
LLPS_LOG_EVIDENCE=1
LLPS_LOG_IO=0
